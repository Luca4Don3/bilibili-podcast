#!/usr/bin/env python3
"""
bilipod-crontab — Read series configs and generate/manage cron.

Usage:
  bilipod-crontab [--config-dir DIR | --config-db DB] [--apply] [--print]

  --config-dir    Explicit legacy YAML rollback directory
  --config-db     SQLite database path (replaces --config-dir)
  --apply         Write generated crontab and wrapper scripts
  --print         Print generated crontab entries to stdout (default)
  --script-dir    Directory for auto-generated wrapper scripts (default: auto)
  --cron-user     Crontab user (default: bilipod)
  --force         Overwrite existing wrapper scripts
"""

import argparse
import getpass
import hashlib
import os
import re
import shlex
import stat
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

PROJECT_SRC = Path(__file__).resolve().parent.parent / "src"
if PROJECT_SRC.is_dir():
    sys.path.insert(0, str(PROJECT_SRC))

try:
    import yaml
except ImportError:
    print("bilipod-crontab requires PyYAML: pip install pyyaml", file=sys.stderr)
    sys.exit(1)


SERIES_SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")

# Markers for auto-generated crontab sections
AUTO_BEGIN_MARKER = "# BEGIN BILIPOD AUTO"
AUTO_END_MARKER = "# END BILIPOD AUTO"
COMMAND_TIMEOUT = 10
SYNC_UNIT_GLOB = "bilipod-sync@*.service"


def cron_marker_title(title, series: str) -> str:
    """Return a single-line title safe for an auto crontab marker."""
    normalized = " ".join(str(title or "").splitlines()).strip()
    return normalized or series


def systemd_timer_is_enabled(series: str) -> bool:
    """Return whether an existing systemd timer should own this series."""
    timer_unit = SYNC_UNIT_GLOB.replace("*", series).removesuffix(".service") + ".timer"
    try:
        result = subprocess.run(
            ["systemctl", "is-enabled", timer_unit],
            capture_output=True, text=True, timeout=COMMAND_TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and result.stdout.strip() == "enabled"


UNIFIED_WRAPPER_TEMPLATE = """#!/bin/sh
set -eu
export BILIPOD_CONFIG_ROOT={CONFIG_ROOT}

MAX_DOWNLOADS_PER_RUN=${{MAX_DOWNLOADS_PER_RUN:-{MAX_DOWNLOADS}}}
FORCE=${{FORCE:-0}}
DEBUG=${{DEBUG:-0}}
LOG_LEVEL=${{LOG_LEVEL:-}}

EXTRA_ARGS=""
if [ "$FORCE" = "1" ]; then
  EXTRA_ARGS="$EXTRA_ARGS --force"
fi
if [ "$DEBUG" = "1" ]; then
  EXTRA_ARGS="$EXTRA_ARGS --debug"
elif [ -n "$LOG_LEVEL" ]; then
  echo "warning: LOG_LEVEL is deprecated; use sync.toml, or a CLI override" >&2
  EXTRA_ARGS="$EXTRA_ARGS --log-level $LOG_LEVEL"
fi
if [ "$MAX_DOWNLOADS_PER_RUN" != "{MAX_DOWNLOADS}" ]; then
  echo "warning: MAX_DOWNLOADS_PER_RUN is deprecated; applying it as a one-run CLI override" >&2
fi

exec {BILIPOD_SYNC_PATH} \
  --series {SERIES} \
  --token "__MEDIA_PLACEHOLDER__" \
  --max-downloads-per-run "$MAX_DOWNLOADS_PER_RUN" \
  --apply \
  $EXTRA_ARGS
"""


def load_configs(config_dir: str | None, db_path: str | None) -> list[dict]:
    """Load series configs from YAML directory or SQLite DB."""
    if db_path:
        return _load_configs_from_db(db_path)
    if config_dir:
        return _load_configs_from_yaml(config_dir)
    return []


def _load_configs_from_yaml(config_dir: str) -> list[dict]:
    configs = []
    path = Path(config_dir)
    for yaml_path in sorted(path.glob("*.yaml")):
        if yaml_path.name.startswith("_"):
            continue
        data = yaml.safe_load(yaml_path.read_text(encoding="utf-8"))
        if not data:
            continue
        configs.append(data)
    return configs


def _load_configs_from_db(db_path: str) -> list[dict]:
    """Load configs from SQLite and convert to dict format with cron schedules."""
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
    from bilibili_podcast import db as _db
    import sqlite3 as _sqlite3

    configs = []
    cfgs = _db.load_series_configs(db_path)

    conn = _sqlite3.connect(db_path)
    conn.row_factory = _sqlite3.Row
    try:
        has_backend_table = conn.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='scheduler_backend'"
        ).fetchone() is not None
        for cfg in cfgs:
            backend_row = None
            if has_backend_table:
                backend_row = conn.execute(
                    "SELECT backend FROM scheduler_backend WHERE series=?",
                    (cfg.series,),
                ).fetchone()
            if (
                backend_row is not None and backend_row["backend"] == "systemd"
            ) or systemd_timer_is_enabled(cfg.series):
                continue
            retry_row = conn.execute(
                "SELECT 1 FROM cron_schedule "
                "WHERE series=? AND enabled=1 AND kind='retry' LIMIT 1",
                (cfg.series,),
            ).fetchone()
            if retry_row is not None:
                print(
                    f"ERROR: cron backend does not support retry schedules: {cfg.series}",
                    file=sys.stderr,
                )
                raise SystemExit(2)
            row = conn.execute(
                "SELECT schedule FROM cron_schedule "
                "WHERE series=? AND enabled=1 AND kind='primary' ORDER BY position",
                (cfg.series,),
            ).fetchall()
            schedules = [r["schedule"] for r in row]
            configs.append(_series_config_to_dict(cfg, schedules))
    finally:
        conn.close()

    return configs


def _series_config_to_dict(cfg, schedules: list[str]) -> dict:
    """Convert a SeriesConfig + cron schedules back to the plain dict format."""
    d = {
        "series": cfg.series,
        "enabled": cfg.enabled,
        "title": cfg.title,
        "description": cfg.description,
        "author": cfg.author,
        "cover_art": cfg.cover_art,
        "category": cfg.category,
        "subcategories": cfg.subcategories,
        "explicit": cfg.explicit,
        "lang": cfg.lang,
        "source": cfg.source,
        "sync": cfg.sync,
        "filters": cfg.filters,
        "paid_preview": cfg.paid_preview,
    }
    if schedules:
        d["cron"] = {"enabled": True, "schedules": schedules}
    return d


def parse_cron_schedules(config: dict) -> list[str]:
    """Extract cron schedules from a series config."""
    cron = config.get("cron") or {}
    if not cron.get("enabled", False):
        return []

    schedules = cron.get("schedules")
    if schedules:
        return [str(s).strip() for s in schedules if str(s).strip()]

    # Derive from update_period if no explicit schedules
    sync = config.get("sync") or {}
    period = str(sync.get("update_period", "")).strip().lower()
    hours = parse_hours(period)
    if hours and hours > 0:
        return derive_cron_from_period(hours, config.get("series", "unknown"))

    return []


def parse_hours(period: str) -> int:
    """Parse update_period like '12h', '8h', '6h' into hours."""
    if not period:
        return 0
    try:
        period = period.strip().lower()
        if period.endswith("h"):
            return max(int(period[:-1]), 1)
        if period.endswith("d"):
            return int(period[:-1]) * 24
        return int(period)
    except (ValueError, TypeError):
        return 0


def derive_cron_from_period(hours: int, series_name: str) -> list[str]:
    """Derive cron schedules from update_period, avoiding round minutes."""
    if hours <= 0 or hours > 24:
        return []

    # Use series name hash to pick a stable non-round minute
    minute_seed = int.from_bytes(hashlib.sha256(series_name.encode()).digest()[:8], "big")
    minute = (minute_seed % 54) + 2  # 2-55 range
    # Pick a stable starting hour to avoid :00/:30
    hour_seed = int.from_bytes(hashlib.sha256(f"{series_name}_base".encode()).digest()[:8], "big")
    start_hour = (hour_seed % 6) + 1  # 1-6

    num_entries = max(24 // hours, 1)
    if 24 % hours != 0:
        num_entries += 1

    schedules = []
    for i in range(num_entries):
        h = (start_hour + i * hours) % 24
        schedules.append(f"{minute} {h} * * *")

    return schedules


def generate_wrapper_script(series_name: str, config_dir: str | None, config_db: str | None, script_dir: str, force: bool) -> Path | None:
    """Generate a wrapper script for a series if it doesn't exist."""
    script_path = Path(script_dir) / f"run_{series_name}_sync.sh"

    if script_path.exists() and not force:
        return script_path  # Already exists, skip

    script_dir_path = Path(script_dir)
    script_dir_path.mkdir(parents=True, exist_ok=True)

    config_root = os.environ.get("BILIPOD_CONFIG_ROOT")
    if config_root:
        from bilibili_podcast.config import ConfigManager

        snapshot = ConfigManager(config_root).load()
        content = UNIFIED_WRAPPER_TEMPLATE.format(
            CONFIG_ROOT=shlex.quote(str(snapshot.root)),
            MAX_DOWNLOADS=shlex.quote(str(snapshot.sync.downloads.scheduled_max_per_run)),
            BILIPOD_SYNC_PATH=shlex.quote(str(snapshot.app.executables.sync)),
            SERIES=shlex.quote(series_name),
        )
        script_path.write_text(content, encoding="utf-8")
        script_path.chmod(script_path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        print(f"  generated: {script_path}", file=sys.stderr)
        return script_path

    raise RuntimeError("BILIPOD_CONFIG_ROOT is required to generate wrapper scripts")


def generate_crontab(configs: list[dict], config_dir: str | None, config_db: str | None, script_dir: str) -> str:
    """Generate crontab entries from configs."""
    lines = []
    first = True

    for config in configs:
        if not config.get("enabled", True):
            continue

        series = config.get("series", "")
        if not series:
            continue

        schedules = parse_cron_schedules(config)
        if not schedules:
            continue

        wrapper_name = f"run_{series}_sync.sh"
        wrapper_path = Path(script_dir) / wrapper_name

        if not first:
            lines.append("")
        first = False

        title = cron_marker_title(config.get("title"), series)
        lines.append(f"{AUTO_BEGIN_MARKER} - {series} ({title})")
        for sched in schedules:
            lines.append(f"{sched} {wrapper_path}")
        lines.append(f"{AUTO_END_MARKER}")

    return "\n".join(lines) + "\n" if lines else ""


def merge_with_existing_crontab(new_auto: str, user: str) -> str:
    """Merge auto-generated entries with existing crontab, preserving manual entries."""
    current_user = getpass.getuser()
    try:
        if user and user != current_user:
            result = subprocess.run(
                ["crontab", "-l", "-u", user],
                capture_output=True, text=True, timeout=COMMAND_TIMEOUT,
            )
        else:
            result = subprocess.run(
                ["crontab", "-l"],
                capture_output=True, text=True, timeout=COMMAND_TIMEOUT,
            )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"cannot read existing crontab: {type(exc).__name__}") from None
    if result.returncode == 0:
        existing = result.stdout
    elif "no crontab" in (result.stderr or "").lower():
        existing = ""
    else:
        raise RuntimeError("cannot read existing crontab: command failed")

    # Remove existing auto sections
    cleaned = re.sub(
        rf"^{AUTO_BEGIN_MARKER}(?:\s+-[^\r\n]*)?\r?\n.*?^{AUTO_END_MARKER}\r?\n?",
        "",
        existing,
        flags=re.DOTALL | re.MULTILINE,
    )
    cleaned = cleaned.strip()
    if cleaned:
        cleaned += "\n\n"

    # Append new auto entries
    new_auto = new_auto.strip()
    if new_auto:
        cleaned += new_auto + "\n"

    return cleaned


def write_crontab(content: str, user: str):
    """Write merged crontab.

    If *user* matches the current OS user, omit ``-u`` to avoid
    "must be privileged to use -u" when running as the target user.
    """
    current_user = getpass.getuser()
    if user and user != current_user:
        proc = subprocess.run(
            ["crontab", "-u", user, "-"],
            input=content, capture_output=True, text=True, timeout=COMMAND_TIMEOUT,
        )
    else:
        proc = subprocess.run(
            ["crontab", "-"],
            input=content, capture_output=True, text=True, timeout=COMMAND_TIMEOUT,
        )
    if proc.returncode != 0:
        print(f"  error writing crontab: {proc.stderr.strip()}", file=sys.stderr)
        return False
    print(f"  crontab updated ({len(content.splitlines())} lines)", file=sys.stderr)
    return True


def main():
    global COMMAND_TIMEOUT, SYNC_UNIT_GLOB
    parser = argparse.ArgumentParser(description="Generate bilipod crontab from series configs")
    parser.add_argument("--config-dir", help="Explicit legacy YAML rollback directory")
    parser.add_argument("--config-db", default=None, help="SQLite database path (replaces --config-dir)")
    parser.add_argument("--apply", action="store_true", help="Write crontab and wrapper scripts")
    parser.add_argument("--print", action="store_true", help="Print generated crontab (default)")
    parser.add_argument("--script-dir", default=None, help="Directory for auto-generated scripts")
    parser.add_argument("--cron-user", default=None, help="Crontab user")
    parser.add_argument("--force", action="store_true", help="Overwrite existing wrapper scripts")
    args = parser.parse_args()

    snapshot = None
    config_root = os.environ.get("BILIPOD_CONFIG_ROOT")
    needs_unified_defaults = not args.config_db and not args.config_dir
    if config_root and (needs_unified_defaults or Path(config_root).is_dir()):
        from bilibili_podcast.config import ConfigError, ConfigManager

        try:
            snapshot = ConfigManager().load()
        except ConfigError as exc:
            print(f"ERROR: configuration error: {exc}", file=sys.stderr)
            raise SystemExit(exc.exit_code) from None
        if not args.config_db and not args.config_dir:
            args.config_db = str(snapshot.app.database.path)
        if args.script_dir is None:
            args.script_dir = str(snapshot.scheduler.paths.wrapper_dir)
        if args.cron_user is None:
            args.cron_user = snapshot.scheduler.runtime.user
        COMMAND_TIMEOUT = snapshot.scheduler.command_timeout_seconds
        SYNC_UNIT_GLOB = snapshot.scheduler.units.sync_glob
    elif not args.config_db and not args.config_dir:
        parser.error("--config-db or explicit --config-dir is required")
    if args.script_dir is None:
        args.script_dir = "auto"
    if args.cron_user is None:
        args.cron_user = "bilipod"

    # Default: print if neither --apply nor --print
    do_print = args.print or not args.apply
    do_apply = args.apply

    config_dir = Path(args.config_dir) if args.config_dir else None

    source_label = args.config_db or str(config_dir)
    try:
        configs = load_configs(args.config_dir, args.config_db)
    except Exception as exc:
        print(f"ERROR: cannot load scheduling configuration: {type(exc).__name__}", file=sys.stderr)
        raise SystemExit(2) from None
    print(f"loaded {len(configs)} configs from {source_label}", file=sys.stderr)

    script_dir = Path(args.script_dir)

    # Generate crontab
    crontab_text = generate_crontab(configs, args.config_dir, args.config_db, str(script_dir))

    if do_print:
        if crontab_text.strip():
            print(crontab_text)
        else:
            print("# (no auto cron entries)")
    if not do_apply:
        print(f"  0 wrapper scripts ready in {script_dir}", file=sys.stderr)

    if do_apply:
        try:
            merged = merge_with_existing_crontab(crontab_text, args.cron_user)
        except RuntimeError as exc:
            print(f"ERROR: {exc}", file=sys.stderr)
            raise SystemExit(2) from None

        if not os.environ.get("BILIPOD_CONFIG_ROOT"):
            parser.error("BILIPOD_CONFIG_ROOT is required with --apply")
        script_dir.mkdir(parents=True, exist_ok=True)
        generated_scripts = 0
        for config in configs:
            if not config.get("enabled", True):
                continue
            series = config.get("series", "")
            if not series or not SERIES_SLUG_RE.match(series):
                continue
            schedules = parse_cron_schedules(config)
            if not schedules:
                continue
            script_path = generate_wrapper_script(
                series, args.config_dir, args.config_db, str(script_dir), args.force,
            )
            if script_path:
                generated_scripts += 1
        print(f"  {generated_scripts} wrapper scripts ready in {script_dir}", file=sys.stderr)

        if write_crontab(merged, args.cron_user):
            print("  ok — run 'crontab -l -u bilipod' to verify", file=sys.stderr)
        else:
            sys.exit(1)


if __name__ == "__main__":
    main()
