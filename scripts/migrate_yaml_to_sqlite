#!/usr/bin/env python3
"""兼容入口：所有 YAML 迁移逻辑由 config migration 模块负责。"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))

from bilibili_podcast.config.migration import migrate_legacy


def main() -> int:
    parser = argparse.ArgumentParser(description="Migrate legacy YAML configuration through the unified migration module.")
    parser.add_argument("--legacy-env", required=True)
    parser.add_argument("--legacy-web-env", required=True)
    parser.add_argument("--config-dir", required=True)
    parser.add_argument("--legacy-rss-users")
    parser.add_argument("--output-root", required=True)
    parser.add_argument("--series-source", choices=("yaml", "db-authoritative"))
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()
    result = migrate_legacy(
        legacy_env=args.legacy_env,
        legacy_web_env=args.legacy_web_env,
        legacy_series_dir=args.config_dir,
        legacy_rss_users=args.legacy_rss_users,
        output_root=args.output_root,
        apply=args.apply,
        series_source=args.series_source,
    )
    print(f"migration {'applied' if result.applied else 'dry-run'}: {result.series_count} series")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
